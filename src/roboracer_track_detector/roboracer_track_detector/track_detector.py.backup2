#!/usr/bin/env python3

import math
import rclpy

from rclpy.node import Node
from sensor_msgs.msg import LaserScan
from geometry_msgs.msg import PointStamped, PoseStamped
from visualization_msgs.msg import Marker
from nav_msgs.msg import Path


class TrackDetector(Node):

    def __init__(self):
        super().__init__('roboracer_track_detector')

        # --------------------------------------------------
        # Generic local-navigation parameters
        # --------------------------------------------------

        # Only consider the forward field of view.
        self.forward_fov = math.radians(180.0)

        # Ignore objects extremely close to the LiDAR.
        self.min_range = 0.10

        # Anything farther than this is treated as open space.
        self.max_range = 8.0

        # Distance at which a direction is considered blocked.
        self.clearance_threshold = 0.70

        # Target distance ahead of the vehicle.
        self.target_distance = 1.0

        # Smooth target direction between scans.
        self.filtered_angle = 0.0
        self.filter_alpha = 0.25

        self.scan_sub = self.create_subscription(
            LaserScan,
            '/scan',
            self.scan_callback,
            10
        )

        self.target_pub = self.create_publisher(
            PointStamped,
            '/roboracer/target_point',
            10
        )

        self.marker_pub = self.create_publisher(
            Marker,
            '/roboracer/target_marker',
            10
        )

        self.path_pub = self.create_publisher(
            Path,
            '/roboracer/local_path',
            10
        )

        self.get_logger().info(
            'RoboRacer live track detector started'
        )
        self.get_logger().info(
            'Input: /scan'
        )
        self.get_logger().info(
            'Output: /roboracer/target_point'
        )

    def scan_callback(self, scan):

        candidates = []

        # --------------------------------------------------
        # Examine the live Hokuyo scan.
        # --------------------------------------------------

        for i, raw_range in enumerate(scan.ranges):

            angle = scan.angle_min + i * scan.angle_increment

            # Only look in the forward hemisphere.
            if abs(angle) > self.forward_fov / 2.0:
                continue

            if not math.isfinite(raw_range):
                distance = self.max_range
            else:
                distance = max(
                    self.min_range,
                    min(raw_range, self.max_range)
                )

            # Directions with useful clearance are candidates.
            if distance >= self.clearance_threshold:

                # Prefer:
                #   1. large free distance
                #   2. directions reasonably close to straight ahead
                #
                # This avoids choosing a distant opening at an
                # extreme steering angle unnecessarily.
                forward_weight = max(
                    0.0,
                    math.cos(angle)
                )

                score = distance * (
                    0.35 + 0.65 * forward_weight
                )

                candidates.append(
                    (score, angle, distance)
                )

        if not candidates:
            self.get_logger().warn(
                'No safe forward direction detected'
            )
            return

        # Highest scoring free direction.
        _, best_angle, best_distance = max(
            candidates,
            key=lambda x: x[0]
        )

        # --------------------------------------------------
        # Smooth steering target
        # --------------------------------------------------

        self.filtered_angle = (
            (1.0 - self.filter_alpha) * self.filtered_angle +
            self.filter_alpha * best_angle
        )

        distance = min(
            self.target_distance,
            best_distance
        )

        target_x = distance * math.cos(
            self.filtered_angle
        )

        target_y = distance * math.sin(
            self.filtered_angle
        )

        # --------------------------------------------------
        # Publish target point
        # --------------------------------------------------

        target = PointStamped()

        target.header.stamp = (
            scan.header.stamp
        )

        target.header.frame_id = scan.header.frame_id

        target.point.x = target_x
        target.point.y = target_y
        target.point.z = 0.0

        self.target_pub.publish(target)

        # --------------------------------------------------
        # RViz marker
        # --------------------------------------------------

        marker = Marker()

        marker.header = target.header
        marker.ns = 'roboracer_track'
        marker.id = 0

        marker.type = Marker.SPHERE
        marker.action = Marker.ADD

        marker.pose.position.x = target_x
        marker.pose.position.y = target_y
        marker.pose.position.z = 0.05

        marker.pose.orientation.w = 1.0

        marker.scale.x = 0.15
        marker.scale.y = 0.15
        marker.scale.z = 0.15

        marker.color.r = 0.0
        marker.color.g = 1.0
        marker.color.b = 0.0
        marker.color.a = 1.0

        self.marker_pub.publish(marker)

        # --------------------------------------------------
        # Publish a short local path
        # --------------------------------------------------

        path = Path()
        path.header = target.header

        # Generate points from the LiDAR origin toward the
        # currently selected free-space direction.
        number_of_points = 10

        for i in range(1, number_of_points + 1):

            ratio = i / number_of_points
            d = distance * ratio

            pose = PoseStamped()
            pose.header = path.header

            pose.pose.position.x = (
                d * math.cos(self.filtered_angle)
            )

            pose.pose.position.y = (
                d * math.sin(self.filtered_angle)
            )

            pose.pose.position.z = 0.0

            # Orient each pose along the selected path.
            half_yaw = self.filtered_angle / 2.0
            pose.pose.orientation.z = math.sin(half_yaw)
            pose.pose.orientation.w = math.cos(half_yaw)

            path.poses.append(pose)

        self.path_pub.publish(path)


def main(args=None):

    rclpy.init(args=args)

    node = TrackDetector()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass

    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
