<?xml version="1.0"?>
<package format="3">
  <name>roboracer_autodrive_bridge</name>
  <version>0.1.0</version>
  <description>Adapter between the RoboRacer autonomy stack and the AutoDRIVE RoboRacer digital twin</description>
  <maintainer email="capstone@localhost">capstone</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>autoware_control_msgs</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
